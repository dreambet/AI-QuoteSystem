# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# Dify Chat App Configuration (server-side only - never expose this key in frontend code)
DIFY_API_BASE=http://10.0.64.115/v1
DIFY_API_KEY=your_dify_app_api_key_here

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Server Configuration
PORT=3001
NODE_ENV=development

# MySQL quote database (server-side only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=quote
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_password
MYSQL_CONNECTION_LIMIT=10
