# DeepSeek API Configuration
# 注意：DEEPSEEK_API_BASE 与 DEEPSEEK_MODEL 必须配套（服务无 key 时 AI 功能优雅降级，但 base+model 不匹配会让 AI 调用全部失败）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# AI 工艺初稿：未配置 Key、服务超时或校验不通过时自动回退本地规则初稿。
AI_PROCESS_DRAFT_ENABLED=true
AI_PROCESS_DRAFT_TIMEOUT_MS=60000
AI_PROCESS_DRAFT_FIRST_TOKEN_TIMEOUT_MS=25000
# 对 deepseek-v4-flash 请求实时推理增量；仅在网关不兼容时设为 false。
AI_PROCESS_DRAFT_THINKING_ENABLED=true
# 适度限制第二步输出，缩短生成等待；复杂零件可按需上调。
AI_PROCESS_DRAFT_MAX_TOKENS=1800
# 第四步报价建议与 AI 审核：输入已做白名单压缩；可按模型能力微调输出上限。
AI_QUOTE_MAX_TOKENS=1600
AI_REVIEW_MAX_TOKENS=1800
# 第四步 AI 建议与 AI 审核请求上限（超时会使用本地规则层或提示重试）
AI_REQUEST_TIMEOUT_MS=60000

# Dify Chat App Configuration (server-side only - never expose this key in frontend code)
DIFY_API_BASE=http://your_dify_host/v1
DIFY_API_KEY=your_dify_app_api_key_here

# File Upload Configuration
# 图纸仅存放在服务端私有目录；到期仅清理“未关联报价”的文件。
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
UPLOAD_RETENTION_DAYS=90
CAD_PARSE_QUEUE_LIMIT=8
CAD_PARSE_TIMEOUT_MS=120000

# Server Configuration
# 生产环境置 production；前端构建产物(frontend/build)存在时由本服务直接托管，访问 http://<内网IP>:3001
PORT=3001
NODE_ENV=development
API_RATE_LIMIT_PER_MINUTE=240

# 登录与受控访问（生产环境必须使用独立、随机且不少于 32 位的 AUTH_TOKEN_SECRET）
AUTH_TOKEN_SECRET=replace_with_a_random_32_plus_character_secret
AUTH_TOKEN_TTL_SECONDS=28800
# 仅在 users 表不存在启用管理员时创建一次；创建成功后可从部署环境移除 ADMIN_INITIAL_PASSWORD。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_your_initial_password

# MySQL quote database (server-side only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=quote
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_password
MYSQL_CONNECTION_LIMIT=10
